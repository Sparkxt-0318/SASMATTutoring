# Copy to .env for local development. In production, set these in Vercel →
# Project Settings → Environment Variables.

# --- Database (Neon) ---
# Use the POOLED connection string (host contains "-pooler") for DATABASE_URL.
# Use the direct (non-pooled) string for DIRECT_URL (migrations run through it).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Admin ---
# Shared officer password for /admin/login.
ADMIN_PASSWORD="change-me"
# 32+ random bytes for signing the admin session cookie.
# Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-32-random-bytes"

# --- Email (Resend) ---
RESEND_API_KEY="re_xxx"
# Must be a verified sender. Before your domain is verified, use onboarding@resend.dev
# (Resend then only delivers to your own account email, a built-in safety net).
EMAIL_FROM="MAT Tutoring <onboarding@resend.dev>"
# Weekly hours digest + failure alerts go ONLY here.
REPORT_EMAIL="siyeong0318@gmail.com"

# --- App ---
# Absolute base URL used inside email links.
APP_URL="http://localhost:3000"
# Hours each member is working toward (one progress-grid square = 15 minutes).
MEMBER_HOURS_GOAL="20"

# --- Safety switches for development ---
# "true" = render emails to the server console instead of sending anything.
EMAIL_DRY_RUN="true"
# If set, EVERY outbound email is rerouted to this address
# (the real recipient is prepended to the subject line).
TEST_EMAIL_OVERRIDE=""

# --- Cron ---
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" to cron routes.
CRON_SECRET="change-me"
