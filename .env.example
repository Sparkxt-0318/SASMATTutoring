# Copy to .env for local development. In production, set these in Vercel →
# Project Settings → Environment Variables.

# --- Database (Neon) ---
# Use the POOLED connection string (host contains "-pooler") for DATABASE_URL.
# Use the direct (non-pooled) string for DIRECT_URL (migrations run through it).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Admin ---
# Shared officer password for /admin/login.
ADMIN_PASSWORD="change-me"
# 32+ random bytes for signing the admin session cookie.
# Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-32-random-bytes"

# --- Email ---
# "resend" (default) or "smtp". SMTP sends through a normal mailbox (a school or
# Gmail account), so you do not need to own a domain.
EMAIL_PROVIDER="resend"
# Who the mail appears to be from. With SMTP, use the mailbox you log in with.
EMAIL_FROM="MAT Tutoring <onboarding@resend.dev>"

# Used when EMAIL_PROVIDER="resend". Until a domain is verified in Resend, it only
# delivers to your own Resend account email.
RESEND_API_KEY="re_xxx"

# Used when EMAIL_PROVIDER="smtp". Gmail: smtp.gmail.com. Microsoft 365 (Outlook):
# smtp.office365.com. Port 587 (or 465).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
# An app password for that mailbox, not your normal password.
SMTP_PASSWORD=""
# Weekly hours digest + failure alerts go ONLY here.
REPORT_EMAIL="siyeong0318@gmail.com"

# --- App ---
# Absolute base URL used inside email links.
APP_URL="http://localhost:3000"
# Link to the club's credit spreadsheet, shown as "Check Your Credits" on the member
# and officer dashboards. Set it in Vercel, not in code: the repository is public and
# this is a private sharing link. Must start with https://
CREDITS_URL=""

# Who can create a member account: "open" (anyone, the default) or "roster" (only
# emails an officer added in the admin Members tab).
MEMBER_SIGNUP="open"
# Hours each member is working toward (one progress-grid square = 15 minutes).
MEMBER_HOURS_GOAL="20"

# --- Safety switches for development ---
# "true" = render emails to the server console instead of sending anything.
EMAIL_DRY_RUN="true"
# If set, EVERY outbound email is rerouted to this address
# (the real recipient is prepended to the subject line).
TEST_EMAIL_OVERRIDE=""

# --- Cron ---
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" to cron routes.
CRON_SECRET="change-me"
