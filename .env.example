# Copy to .env for local development. In production, set these in Vercel →
# Project Settings → Environment Variables.

# --- Database (Neon) ---
# Use the POOLED connection string (host contains "-pooler") for DATABASE_URL.
# Use the direct (non-pooled) string for DIRECT_URL (migrations run through it).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Admin ---
# Shared officer password for /admin/login.
ADMIN_PASSWORD="change-me"
# 32+ random bytes for signing the admin session cookie.
# Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-32-random-bytes"

# --- Email ---
# Easiest: a club Gmail account. Set only SMTP_USER (the Gmail address) and
# SMTP_PASSWORD (a Gmail app password). The site then switches to SMTP, uses
# smtp.gmail.com, and sends from that address by itself.
# EMAIL_PROVIDER forces "smtp" or "resend". Leave it empty to decide automatically.
EMAIL_PROVIDER=""
# Who the mail appears to be from. With SMTP the mailbox's own address is used and
# only the display name here is kept, so this can stay empty.
EMAIL_FROM=""

# Used when sending through Resend. Until a domain is verified in Resend, it only
# delivers to your own Resend account email.
RESEND_API_KEY="re_xxx"

# SMTP mailbox login. For a Gmail address SMTP_HOST is ignored (smtp.gmail.com is used).
# Other providers: Microsoft 365 is smtp.office365.com. Port 587 (or 465).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
# An app password for that mailbox, not your normal password. Spaces are fine.
SMTP_PASSWORD=""
# Weekly hours digest + failure alerts go ONLY here.
REPORT_EMAIL="officer@example.com"
# Extra people who also get the WEEKLY hours report and backup files (comma separated).
# Each gets their own copy. REPORT_EMAIL still receives it too.
WEEKLY_REPORT_EMAILS=""
# Extra people who also get ALERT emails (failures, "needs attention"), comma separated.
# They are added on top of REPORT_EMAIL. The weekly report and backups go to REPORT_EMAIL only.
EXTRA_ALERT_EMAILS=""
# Members sign in with an emailed one-time code. Everyone active in the admin Members
# tab can. These are EXTRA addresses that can sign in too (comma separated), for
# example an officer testing the member pages. Usually empty.
OTP_LOGIN_EMAILS=""

# --- App ---
# Absolute base URL used inside email links. Optional on Vercel: the production
# address is used automatically when this is empty.
APP_URL="http://localhost:3000"
# Link to the club's credit spreadsheet, shown as "Check Your Credits" on the member
# and officer dashboards. Set it in Vercel, not in code: the repository is public and
# this is a private sharing link. Must start with https://
CREDITS_URL=""

# Hours each member is working toward (one progress-grid square = one hour).
MEMBER_HOURS_GOAL="20"

# --- Safety switches for development ---
# "true" = render emails to the server console instead of sending anything.
EMAIL_DRY_RUN="true"
# If set, EVERY outbound email is rerouted to this address
# (the real recipient is prepended to the subject line).
TEST_EMAIL_OVERRIDE=""

# --- Cron ---
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" to cron routes.
CRON_SECRET="change-me"
