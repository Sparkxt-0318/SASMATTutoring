generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RequestStatus {
  /// Submitted, waiting for the student to press the link in their confirmation email.
  UNCONFIRMED
  OPEN
  CLAIMED
  COMPLETED
  CANCELLED
  EXPIRED
}

/// Officers record credit directly, so only APPROVED is ever written. PENDING and
/// REJECTED stay so old rows and the column default keep working without a type rewrite.
enum CreditStatus {
  PENDING
  APPROVED
  REJECTED
}

model Member {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  /// Part of every member session. Bumped on deactivation, so old sessions stay
  /// dead even if the member is reactivated later.
  sessionVersion Int @default(0)

  claimTokens     ClaimToken[]
  claimedRequests TutoringRequest[] @relation("ClaimedBy")
  credits         CreditLog[]
}

/// One-time sign-in PIN for an email address. Only a keyed hash is stored, never the code itself.
model LoginCode {
  id          String    @id @default(cuid())
  email       String
  /// First sign in of an OTP_LOGIN_EMAILS address: the name to use once the code is verified.
  pendingName String?
  codeHash    String
  attempts    Int       @default(0)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([email, createdAt])
}

/// One officer sign-in attempt, kept for 15 minutes of throttling. Only a keyed hash of the IP.
model AdminLoginAttempt {
  id        String   @id @default(cuid())
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
  @@index([createdAt])
}

/// Emails sent per UTC day, so a burst can never use up the mailbox's daily limit.
model EmailBudget {
  day       String    @id
  sent      Int       @default(0)
  alertedAt DateTime?
}

model TutoringRequest {
  id           String        @id @default(cuid())
  studentName  String
  studentEmail String
  gradeLevel   String
  subject      String
  topic        String        @db.Text
  // The session the student asked for (stored as UTC, entered in Shanghai time).
  meetingStart DateTime
  meetingEnd   DateTime
  // Survey only: null for requests that predate the question. Never shown to tutors.
  receivedTeacherHelp Boolean?
  status       RequestStatus @default(OPEN)
  claimedById  String?
  claimedBy    Member?       @relation("ClaimedBy", fields: [claimedById], references: [id])
  claimedAt    DateTime?
  createdAt    DateTime      @default(now())
  /// Secret in the student's confirmation link, which also opens their status page.
  confirmToken String?       @unique
  /// When the student confirmed. Members are emailed only after this.
  confirmedAt  DateTime?

  claimTokens ClaimToken[]
  credit      CreditLog?

  @@index([status, createdAt])
}

model ClaimToken {
  id        String    @id @default(cuid())
  token     String    @unique
  requestId String
  memberId  String
  emailedAt DateTime?
  createdAt DateTime  @default(now())

  request TutoringRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  member  Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([requestId, memberId])
}

model CreditLog {
  id          String       @id @default(cuid())
  requestId   String       @unique
  memberId    String
  minutes     Int
  notes       String?      @db.Text
  status      CreditStatus @default(PENDING)
  submittedAt DateTime     @default(now())
  reviewedAt  DateTime?

  request TutoringRequest @relation(fields: [requestId], references: [id])
  member  Member          @relation(fields: [memberId], references: [id])

  @@index([status])
}
